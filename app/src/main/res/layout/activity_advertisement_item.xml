<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Advertisement Image -->
        <ImageView
            android:id="@+id/imgAdvertisement"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/anh_nen" />

        <!-- Advertisement Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Advertisement Title -->
            <TextView
                android:id="@+id/tvAdvertisementTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tên quảng cáo"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Advertisement Location -->
            <TextView
                android:id="@+id/tvAdvertisementLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Vị trí quảng cáo"
                android:textColor="#757575"
                android:textSize="14sp" />

            <!-- Advertisement Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <!-- Edit Button -->
                <ImageButton
                    android:id="@+id/btnEditAdvertisement"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="Edit Advertisement"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_edit_blue"
                    app:tint="@color/blue" />

                <!-- Delete Button -->
                <ImageButton
                    android:id="@+id/btnDeleteAdvertisement"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="Delete Advertisement"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_delete_blue"
                    app:tint="@color/red" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
