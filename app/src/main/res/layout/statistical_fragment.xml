<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="12dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center|start"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/icon_get_revenue_blue_50"
                    app:tint="@color/blue" />

                <TextView
                    android:id="@+id/txtTotalRevenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Revenue"
                    android:textColor="@color/blue"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.example.basicmobileprogramingproject.Adapter.CustomChartView
                android:id="@+id/chartTotalRevenue"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:chartType="BAR_CHART" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center|start"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/icon_order_blue"
                    app:tint="@color/blue" />

                <TextView
                    android:id="@+id/txtTotalOrders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Orders"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.example.basicmobileprogramingproject.Adapter.CustomChartView
                android:id="@+id/chartTotalOrders"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:chartType="PIE_CHART" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center|start"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/icon_product_white"
                    app:tint="@color/blue" />

                <TextView
                    android:id="@+id/txtBestSellingProducts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Selling Products"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.example.basicmobileprogramingproject.Adapter.CustomChartView
                android:id="@+id/chartBestSelling"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:chartType="LINE_CHART" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center|start"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/icon_product_white"
                    app:tint="@color/blue" />

                <TextView
                    android:id="@+id/txtLowStockAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low Stock Alert"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.example.basicmobileprogramingproject.Adapter.CustomChartView
                android:id="@+id/chartLowStock"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:chartType="LINE_CHART" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center|start"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/icon_user_blue"
                    app:tint="@color/blue" />

                <TextView
                    android:id="@+id/txtTotalUsers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Users"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.example.basicmobileprogramingproject.Adapter.CustomChartView
                android:id="@+id/chartTotalUsers"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:chartType="PIE_CHART" />

            <Button
                android:id="@+id/btnExportReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/blue"
                android:text="Export Report"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
